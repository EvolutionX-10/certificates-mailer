{
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@utils": ["./src/utils/index.ts"]
		},
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"module": "NodeNext",
		"target": "ESNext",
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
