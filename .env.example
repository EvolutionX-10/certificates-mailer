# SMTP settings (587 uses STARTTLS; 465 uses implicit TLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Optional: override implicit TLS detection for a nonstandard port
# SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

FROM="Certificates <certificates@example.com>"
SUBJECT="Your certificate"

CSV_FILE="./assets/data.csv"
TEMPLATE_FILE="./templates/template.html"

# PDF is used by the default entrypoint; image settings are only needed for PNGs.
BASE_PDF="./assets/certificate.pdf"
BASE_IMG="./assets/certificate.png"
OUTPUT_PDF="./pdf"
OUTPUT_IMG="./image"
# PDF: a standard font name (e.g. Helvetica), or assets/<FONT>.ttf.
# PNG: a font family installed on your system.
FONT=Helvetica
FONT_SIZE=32

# Use a mailbox you control. Test mode DOES send an email to this address.
TEST_NAME="Your Name"
TEST_EMAIL=you@example.com

# Use a separate directory for each event/campaign.
STATS_DIR="./stats"
